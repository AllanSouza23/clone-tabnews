{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Estudo e reimplementação do https://www.tabnews.com.br desenvolvidas através do https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "./init-dev.sh",
    "services:up": "docker compose -f infra/compose.yml up -d",
    "services:stop": "docker compose -f infra/compose.yml stop",
    "services:down": "docker compose -f infra/compose.yml down --volumes",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watchAll",
    "migration:create": "node-pg-migrate -m infra/migrations create",
    "migration:up": "node-pg-migrate -m infra/migrations --env-path .env.development up"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.4",
    "next": "^13.1.6",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^29.6.2",
    "prettier": "^3.4.2"
  }
}
